# Google AdSense publisher ID. Optional override only — the live ID
# (ca-pub-8487777891911418) is committed in src/components/ads/client.ts because
# it is public anyway. Set this to point a build at a different property.
VITE_ADSENSE_CLIENT=

# Optional booking-form POST endpoint (Formspree, Web3Forms, Netlify Forms).
# Unset, the contact form falls back to opening the visitor's mail client.
VITE_FORM_ENDPOINT=
