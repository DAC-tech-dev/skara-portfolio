# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
# Leave unset in development — ad slots render nothing without it.
VITE_ADSENSE_CLIENT=

# Optional booking-form POST endpoint (Formspree, Web3Forms, Netlify Forms).
# Unset, the contact form falls back to opening the visitor's mail client.
VITE_FORM_ENDPOINT=
